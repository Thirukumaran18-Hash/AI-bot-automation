# Copy this file to backend/.env and adjust as needed.
# Settings are read by pydantic-settings from the backend directory.

APP_NAME="InternFlow AI"
ENVIRONMENT=development
API_PREFIX=/api

# SQLite is the default. Example absolute path:
# DATABASE_URL=sqlite:///C:/Games/new project/backend/internflow.db
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=720

FRONTEND_ORIGIN=http://localhost:5173
# Defaults to backend/storage. Relative paths resolve from the start directory.
# STORAGE_DIR=storage
MAX_UPLOAD_MB=10

PASS_THRESHOLD=70
CONFIDENCE_THRESHOLD=0.55
BORDERLINE_MARGIN=8
REVIEW_SLA_HOURS=48

# Email: leave SMTP_HOST empty to use the local email log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@internflow.local
SMTP_TLS=true

# Any public Jitsi host gives real, joinable meeting links with no API key.
MEETING_BASE_URL=https://meet.jit.si
COMPANY_TIMEZONE=Asia/Kolkata
APP_PUBLIC_URL=http://127.0.0.1:8000

# Automation timing
AUTOPILOT_LEAD_MINUTES=5
AUTOPILOT_MEETING_MINUTES=30
AUTOPILOT_DUE_DAYS=2

# AI: heuristic works offline. Use openai for an LLM-assisted review.
AI_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=25

SCHEDULER_ENABLED=true
REMINDER_INTERVAL_MINUTES=15
SEED_DEMO_DATA=true
